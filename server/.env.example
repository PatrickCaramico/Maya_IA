# Copie este arquivo para "server/.env" e preencha com sua chave real.
# O arquivo "server/.env" já está no .gitignore — NUNCA remova essa linha
# nem suba sua chave real para o GitHub ou qualquer lugar público.

ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Porta em que o backend vai rodar localmente
PORT=8787

# Origem permitida por CORS. Em desenvolvimento, deixe como está.
# Em produção, troque pelo domínio real do site (ex: https://trickgamer112.com)
ALLOWED_ORIGIN=http://localhost:5173
