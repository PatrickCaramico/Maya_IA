    @apply text-muted;
  }
  .input-nebula:focus {
    @apply border-pulse;
    box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.2);
  }

  /* --- Prose / Maya Output --- */
  .prose-maya {
    @apply text-frost/90 leading-relaxed;
  }
  .prose-maya h1 { @apply text-2xl font-heading font-bold text-frost mt-6 mb-3; }
  .prose-maya h2 { @apply text-lg font-heading font-bold text-signal mt-5 mb-2.5 border-b border-nebula-border pb-1.5; }
  .prose-maya h3 { @apply text-base font-heading font-semibold text-pulse mt-4 mb-2; }
  .prose-maya p  { @apply my-2 text-frost/90 leading-relaxed; }
  .prose-maya ul, .prose-maya ol { @apply ml-5 my-2; }
  .prose-maya li { @apply my-1; }
  .prose-maya strong { @apply text-white font-semibold; }
  .prose-maya blockquote {
    @apply border-l-4 border-pulse bg-pulse/10 italic px-4 py-2.5 my-3 rounded-r-lg text-frost/85 text-sm;
  }
  .prose-maya code {
    @apply px-1.5 py-0.5 rounded bg-black/40 text-signal text-xs font-mono border border-nebula-border;
  }
  .prose-maya pre {
    @apply bg-black/60 border border-nebula-border rounded-lg p-4 my-3 overflow-x-auto;
  }
  .prose-maya pre code { @apply bg-transparent border-none p-0; }
  .prose-maya hr { @apply border-nebula-border my-4; }
}

/* ========================================
   UTILITY LAYER — Custom Utilities
======================================== */
@layer utilities {
  .text-secondary { color: var(--color-secondary); }
  .text-muted     { color: var(--color-muted); }
  .text-alert     { color: var(--color-alert); }
  .bg-nebula-elevated { background-color: var(--color-nebula-elevated); }
  .border-nebula-border { border-color: var(--color-nebula-border); }

  .shadow-glow-pulse  { box-shadow: 0 0 18px rgba(139, 92, 246, 0.40); }
  .shadow-glow-signal { box-shadow: 0 0 18px rgba(46,  230, 214, 0.40); }
  .shadow-card        { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.40); }
  .font-heading       { font-family: var(--font-heading); }
  .font-body          { font-family: var(--font-body); }
  .font-mono          { font-family: var(--font-mono); }
}

/* ========================================
   KEYFRAMES (não suportados pelo Tailwind config em alguns builds)
======================================== */
@keyframes pulseGlow {
  0%, 100% { box-shadow: 0 0 10px rgba(139, 92, 246, 0.4); }
  50%       { box-shadow: 0 0 22px rgba(139, 92, 246, 0.80); }
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes spinSlow {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.animate-pulse-glow { animation: pulseGlow 2.5s ease-in-out infinite; }
.animate-fade-in    { animation: fadeIn 0.2s ease-out both; }
.animate-spin-slow  { animation: spinSlow 8s linear infinite; }
